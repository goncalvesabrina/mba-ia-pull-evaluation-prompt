# LangSmith Configuration
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Para descobrir seu username: publique qualquer prompt no LangSmith Hub, depois abra-o e clique no ícone de cadeado (🔒) para ver seu username.
USERNAME_LANGSMITH_HUB=

# OpenAI Configuration
OPENAI_API_KEY=

# Google Gemini Configuration
GOOGLE_API_KEY=

# LLM Configuration
# Atenção: gemini-2.5-flash não está mais disponível para chaves criadas
# recentemente (a API responde 404 "no longer available to new users").
# Este projeto foi executado com gemini-3.5-flash.
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash
EVAL_MODEL=gemini-3.5-flash

#LLM_PROVIDER=openai
#LLM_MODEL=gpt-4o-mini
#EVAL_MODEL=gpt-4o